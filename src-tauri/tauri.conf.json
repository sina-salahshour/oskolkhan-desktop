{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OskolKhan",
  "version": "0.1.0",
  "identifier": "com.oskolkhan.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OskolKhan",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0b0b0d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:",
        "media-src": "'self' http://127.0.0.1:* blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "OskolKhan desktop client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
